{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/v1/(.*)",
            "destination": "app/main.py"
        },
        {
            "source": "/(.*)",
            "destination": "frontend/$1"
        }
    ],
    "functions": {
        "app/main.py": {
            "runtime": "vercel-python@4.4.5"
        }
    }
}